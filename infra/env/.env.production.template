# ==============================================================================
# ServicePulse - Production Environment Configuration Template
# Project: ServicePulse — Enterprise Hybrid RMM & ITSM Platform
# Author: Muhammadyusuf Usmonov
# Target Production Domain: https://servicepulse.uz
# ==============================================================================
# IMPORTANT:
# 1. Copy this template to .env.production on your deployment server:
#    cp infra/env/.env.production.template .env.production
# 2. Restrict file permissions immediately:
#    chmod 600 .env.production
# 3. Generate cryptographically strong secrets using:
#    python scripts/generate_secrets.py --write .env.production
# 4. NEVER commit .env.production or any filled credential files to Git.
# ==============================================================================

# Application Identity & Mode
PROJECT_NAME="ServicePulse"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# Domain & Reverse Proxy Routing
DOMAIN_NAME="servicepulse.uz"
ACME_EMAIL="admin@servicepulse.uz"

# Security & Cryptographic Signing
# Generated via: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters (64-char hex recommended)
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX_SECRET_KEY_FOR_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent Global Enrollment Secret
# Generated via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Pre-shared secret required to enroll new Windows Endpoint Agents
AGENT_ENROLLMENT_SECRET="REPLACE_WITH_STRONG_RANDOM_AGENT_ENROLLMENT_SECRET_32_CHARS"

# Database Configuration (PostgreSQL 16)
POSTGRES_DB="servicepulse"
POSTGRES_USER="servicepulse_admin"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD"
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://servicepulse_admin:REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD@db:5432/servicepulse"

# Initial Administrative Accounts (Provisioned on first database initialization)
FIRST_SUPERUSER_EMAIL="admin@servicepulse.uz"
FIRST_SUPERUSER_PASSWORD="REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD"
FIRST_SUPPORT_EMAIL="support@servicepulse.uz"
FIRST_SUPPORT_PASSWORD="REPLACE_WITH_STRONG_INITIAL_SUPPORT_PASSWORD"
FIRST_EMPLOYEE_EMAIL="employee@servicepulse.uz"
FIRST_EMPLOYEE_PASSWORD="REPLACE_WITH_STRONG_INITIAL_EMPLOYEE_PASSWORD"

# Cross-Origin Resource Sharing (CORS)
# Strictly restricted to production domain over HTTPS
BACKEND_CORS_ORIGINS="https://servicepulse.uz"

# Background Monitoring Worker Settings
MONITORING_INTERVAL_SECONDS=30
CONSECUTIVE_FAILURE_THRESHOLD=3
PING_TIMEOUT_SECONDS=2
TCP_TIMEOUT_SECONDS=3
MONITORING_CONCURRENCY_LIMIT=10
ICMP_ENABLED=true
WORKER_SIMULATION_MODE=false
AUTO_RESOLVE_INCIDENT_ON_RECOVERY=true

# Automated Incident Remediation Policy
ENABLE_AUTOMATED_REMEDIATION=true
MAX_REMEDIATION_RETRIES=2
REMEDIATION_COOLDOWN_SECONDS=300

# Automated Database Backup Settings
BACKUP_RETENTION_DAYS=7
BACKUP_DIR="/var/backups/servicepulse"
