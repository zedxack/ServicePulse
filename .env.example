# ==============================================================================
# ServicePulse Configuration Environment File
# Project: ServicePulse — Enterprise Hybrid RMM & ITSM Platform
# Author: Muhammadyusuf Usmonov
# ==============================================================================

# Application Settings
PROJECT_NAME="ServicePulse"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication (Replace in production with secure 64-char hex)
SECRET_KEY="insecure-default-change-in-production-servicepulse-security-token-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Administrative Accounts (Set secure passwords before initial startup)
FIRST_SUPERUSER_EMAIL="admin@servicepulse.uz"
FIRST_SUPERUSER_PASSWORD="ChangeMeAdmin2026!"
FIRST_SUPPORT_EMAIL="support@servicepulse.uz"
FIRST_SUPPORT_PASSWORD="ChangeMeSupport2026!"
FIRST_EMPLOYEE_EMAIL="employee@servicepulse.uz"
FIRST_EMPLOYEE_PASSWORD="ChangeMeEmployee2026!"

# Agent Global Enrollment Secret (Generate a strong 32+ character random secret)
AGENT_ENROLLMENT_SECRET="replace-with-a-strong-random-enrollment-secret-at-least-32-chars"

# Database Configuration (PostgreSQL Async)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_2026"
POSTGRES_DB="servicepulse"
# For Docker Compose: postgresql+asyncpg://postgres:postgres_password_2026@db:5432/servicepulse
# For local development: postgresql+asyncpg://postgres:postgres_password_2026@localhost:5432/servicepulse
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password_2026@localhost:5432/servicepulse"

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80"

# Monitoring & Incident Settings
MONITORING_INTERVAL_SECONDS=30
CONSECUTIVE_FAILURE_THRESHOLD=3
PING_TIMEOUT_SECONDS=2
TCP_TIMEOUT_SECONDS=3

# Automated Remediation Policy
ENABLE_AUTOMATED_REMEDIATION=true
MAX_REMEDIATION_RETRIES=2
REMEDIATION_COOLDOWN_SECONDS=300
