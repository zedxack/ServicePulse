# ServicePulse — Docker Build Context Ignore List
# DevSecOps Hardening: Exclude secrets, credentials, backups, virtualenvs, build artifacts, databases, and docs

# Version control
.git
.gitignore

# Environment files, secrets & certificates
.env
.env.*
*.key
*.pem
*.crt

# Database backups & dump artifacts
backups/
*.sql
*.sql.gz
*.sql.gz.sha256
*.meta.json
*.dump
*.backup

# Python virtual environments & bytecode caches
.venv
venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node.js & frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Native Windows Agent build outputs
agent/__pycache__/
agent/build/
agent/dist/

# Persistent data volumes, database files & runtime logs
pgdata/
data/
logs/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Documentation & IDE configurations
docs/
README.md
pytest.ini
.vscode/
.idea/
*.log
